# ═══════════════════════════════════════════════════════════════
# ForensiX AI — LangGraph Multi-Agent System
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your API keys

# Gemini (CCTV Agent + Autopsy Agent)
# Fallback chain: gemini-2.5-flash-preview-05-20 → gemini-2.0-flash → gemini-1.5-flash
# If you get 404 errors, the graph.py will auto-try older model versions
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Featherless / Any OpenAI-compatible (Toxicology + Correlation + Explainability)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Alternative: use LLM_* vars for any OpenAI-compatible provider
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# HuggingFace (NER + Zero-shot classification)
HF_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
