# ═══════════════════════════════════════════════════════════════
# ForensiX AI — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your values.
# The system works with ANY combination of these providers.

# ── LLM Providers (configure at least one) ────────────────────
# Google Gemini (required for Autopsy + CCTV agents in LangGraph pipeline)
# Model fallback chain: gemini-2.5-flash-preview-05-20 → gemini-2.0-flash → gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Featherless.ai (recommended for Toxicology / Correlation / Explainability)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TokenRouter (auto-routes to cheapest provider)
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.ai/v1
TOKENROUTER_MODEL=auto

# Together.ai
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# Groq (ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace (for ML pipeline + embeddings + chat)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Custom OpenAI-compatible provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER_NAME=Custom
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# ── Supabase (optional — for cloud persistence + pgvector) ────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (Prisma-compatible) — used when Supabase configured
DATABASE_URL=
DIRECT_URL=

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=forensix-change-me-in-production-2024
